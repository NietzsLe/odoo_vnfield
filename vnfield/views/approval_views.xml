<odoo>
    <record id="approval_kanban_action_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">kanban</field>
        <field name="act_window_id" ref="vnfield_approval_action" />
    </record>
    <record model="ir.ui.view" id="approval_tree_view">
        <field name="name">approval.tree</field>
        <field name="model">vnfield.approval</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="id" readonly="status != 'draft'" />
                <field name="name" readonly="status != 'draft'" />
                <field name="code" readonly="1" />
                <field name="requester_id" />
                <field name="status" />
                <field name="progress_percentage" string="Progress" />
                <field name="current_approver_ids" string="Current Approvers"
                    widget="many2many_tags" />
                <field name="approval_period" readonly="status != 'draft'" />
                <field name="request_at" />
                <field name="priority" readonly="status != 'draft'" />
            </tree>
        </field>
    </record>
    <record model="ir.ui.view" id="approval_form_view">
        <field name="name">approval.form</field>
        <field name="model">vnfield.approval</field>
        <field name="arch" type="xml">
            <form>
                <div class="mb-2">
                    <button invisible="status != 'draft'" name="action_submit_request" type="object"
                        string="Submit Request"
                        class="btn-primary" />
                    <button invisible="status not in ('draft', 'submitted')"
                        name="action_cancel_request" type="object"
                        string="Cancel Request"
                        class="btn-secondary" />
                </div>
                <sheet>
                    <div class="oe_title" invisible="not id">
                        <h1>
                            <field name="name" readonly="status != 'draft'"
                                placeholder="Approval Name..." />
                        </h1>
                        <h3>
                            <field name="code" readonly="1" />
                        </h3>
                    </div>

                    <!-- Status and Progress Info -->
                    <group name="status_info" invisible="status == 'draft'">
                        <group>
                            <field name="status" />
                            <field name="progress_percentage" string="Progress" widget="progressbar" />
                        </group>
                        <group>
                            <field name="current_approver_ids" string="Current Approvers"
                                widget="many2many_tags" readonly="1" />
                            <field name="is_current_user_approver" invisible="1" />
                        </group>
                    </group>

                    <!-- Basic Information -->
                    <group name="basic_info">
                        <group>
                            <field name="id" invisible="not id" />
                            <field name="name" invisible="1" />
                            <field name="description" readonly="not can_user_edit" />
                            <field name="requester_id" readonly="1" />
                        </group>
                        <group>
                            <field name="approval_period" readonly="not can_user_edit" />
                            <field name="request_at" readonly="1" />
                            <field name="priority" readonly="not can_user_edit" />
                            <field name="can_user_edit" invisible="1" />
                        </group>
                    </group>
                    <!-- Approval Steps -->
                    <group name="steps_info" string="Approval Workflow">
                        <field name="root_step_ids" readonly="not can_user_edit">
                            <tree>
                                <field name="name" />
                                <field name="approver_id" />
                                <field name="status" decoration-success="status == 'approved'"
                                    decoration-warning="status == 'in-progress'"
                                    decoration-danger="status == 'rejected'" />
                                <field name="come_at" />
                                <field name="approval_at" />
                                <field name="duration_hours" string="Duration (h)" />
                                <field name="is_overdue" invisible="1" />
                                <button name="open_form_view" type="object" string="View"
                                    icon="fa-eye" />
                            </tree>
                        </field>

                        <field name="processing_step_ids" readonly="1" string="Current Active Steps">
                            <tree>
                                <field name="name" />
                                <field name="approver_id" />
                                <field name="come_at" />
                                <field name="is_overdue" decoration-danger="is_overdue" />
                                <button name="handle_click_review" type="object" string="Review"
                                    invisible="not can_user_approve" class="btn-primary" />
                            </tree>
                        </field>

                        <field name="approval_step_ids" string="All Steps" readonly="1">
                            <tree>
                                <field name="name" />
                                <field name="approver_id" />
                                <field name="status" decoration-success="status == 'approved'"
                                    decoration-warning="status == 'in-progress'"
                                    decoration-danger="status == 'rejected'" />
                                <field name="come_at" />
                                <field name="approval_at" />
                                <field name="duration_hours" string="Duration (h)" />
                            </tree>
                        </field>
                    </group>

                    <!-- <field name="verify_for_task_id" /> -->
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" options="{'post_refresh':True}"
                        groups="base.group_user" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="approval_kanban_view">
        <field name="name">approval.kanban</field>
        <field name="model">vnfield.approval</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_content oe_kanban_global_click">
                            <!-- Header với ID và Name -->
                            <div class="d-flex flex-row gap-2 mb-2">
                                <div class="fw-bold">
                                    <field name="id" />
                                </div>
                                <div class="flex-grow-1">
                                    <field name="name" />
                                </div>
                            </div>

                            <!-- Status với màu sắc -->
                            <div class="mb-2">
                                <span class="badge"
                                    t-attf-class="badge-#{record.status.raw_value == 'approved' and 'success' or record.status.raw_value == 'rejected' and 'danger' or record.status.raw_value == 'submitted' and 'warning' or 'secondary'}">
                                    <field name="status" />
                                </span>

                                <!-- Progress bar cho submitted approvals -->
                                <div t-if="record.status.raw_value == 'submitted'" class="mt-1">
                                    <div class="progress" style="height: 4px;">
                                        <div class="progress-bar" role="progressbar"
                                            t-attf-style="width: #{record.progress_percentage.value}%"
                                            t-attf-aria-valuenow="#{record.progress_percentage.value}"
                                            aria-valuemin="0" aria-valuemax="100">
                                        </div>
                                    </div>
                                    <small class="text-muted">
                                        <field name="progress_percentage" />% Complete </small>
                                </div>
                            </div>

                            <!-- Thông tin chi tiết -->
                            <div class="small text-muted">
                                <div>
                                    <i class="fa fa-user" />
                                    <field name="requester_id" />
                                </div>
                                <div>
                                    <i class="fa fa-calendar" />
                                    <field name="request_at" />
                                </div>
                                <div t-if="record.current_approver_ids.raw_value.length > 0">
                                    <i class="fa fa-clock-o" /> Waiting: <field
                                        name="current_approver_ids" widget="many2many_tags" />
                                </div>
                                <div>
                                    <i class="fa fa-flag"
                                        t-attf-class="text-#{record.priority.raw_value == 'high' and 'danger' or record.priority.raw_value == 'medium' and 'warning' or 'success'}" />
                                    <field name="priority" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="vnfield_approval_action" model="ir.actions.act_window">
        <field name="name">Approval</field>
        <field name="res_model">vnfield.approval</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>